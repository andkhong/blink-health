{
  "name": "blink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "npm --prefix web run dev",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=postgres://blink_app:blink_app@localhost:5442/blink_test OWNER_DATABASE_URL=postgres://blink_owner:blink_owner@localhost:5442/blink_test tsx --test --test-concurrency=1 \"src/server/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
